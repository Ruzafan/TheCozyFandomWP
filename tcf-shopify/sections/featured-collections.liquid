{%- comment -%}
  Cozy Fandom Featured Collections — licensed-fandom cards (Snoopy, Harry Potter, Disney, ...).
{%- endcomment -%}

<section class="py-16 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    {%- if section.settings.title != blank -%}
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-cozy-mint uppercase tracking-widest block mb-2">{{ section.settings.eyebrow | default: 'Explora por fandom' }}</span>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-cozy-coffee">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.collection.url | default: '#' }}"
           class="cozy-collection-card group relative overflow-hidden rounded-[28px] p-6 flex flex-col items-start gap-4 no-underline shadow-sm hover:shadow-lg transition-all {{ block.settings.card_bg | default: 'bg-white' }}"
           {{ block.shopify_attributes }}>
          <div class="w-14 h-14 rounded-2xl {{ block.settings.icon_bg | default: 'bg-cozy-mintLight' }} flex items-center justify-center text-2xl">
            {{ block.settings.icon | default: '✨' }}
          </div>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}"
                 loading="lazy" class="w-full h-40 object-cover rounded-2xl">
          {%- endif -%}
          <div>
            <h3 class="font-serif text-lg font-bold text-cozy-coffee mb-1">{{ block.settings.title }}</h3>
            <p class="text-xs text-cozy-coffee/70 leading-relaxed mb-3">{{ block.settings.description }}</p>
            <span class="text-xs font-bold text-cozy-mint group-hover:underline">{{ block.settings.link_text | default: 'Ver colección' }} →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colecciones destacadas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Explora por fandom" },
    { "type": "text", "id": "title", "label": "Título", "default": "Encuentra tu universo favorito" }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Tarjeta de colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "icon", "label": "Icono (emoji)", "default": "✨" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "description", "label": "Descripción" },
        { "type": "text", "id": "link_text", "label": "Texto del enlace", "default": "Ver colección" },
        {
          "type": "select", "id": "card_bg", "label": "Fondo de tarjeta",
          "options": [
            { "value": "bg-white", "label": "Blanco" },
            { "value": "bg-cozy-sand", "label": "Arena" }
          ],
          "default": "bg-white"
        },
        {
          "type": "select", "id": "icon_bg", "label": "Fondo del icono",
          "options": [
            { "value": "bg-cozy-mintLight", "label": "Menta claro" },
            { "value": "bg-white", "label": "Blanco" }
          ],
          "default": "bg-cozy-mintLight"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones destacadas",
      "blocks": [
        { "type": "collection_card", "settings": { "icon": "🐾", "title": "El Rincón de Snoopy", "description": "El beagle más adorable en tazas, figuras y papelería.", "link_text": "Ver colección Snoopy", "card_bg": "bg-white", "icon_bg": "bg-cozy-mintLight" } },
        { "type": "collection_card", "settings": { "icon": "🎩", "title": "Escoge tu Casa", "description": "Gryffindor, Slytherin, Hufflepuff o Ravenclaw. Magia de Harry Potter.", "link_text": "Entrar al castillo", "card_bg": "bg-cozy-sand", "icon_bg": "bg-white" } },
        { "type": "collection_card", "settings": { "icon": "⭐", "title": "La Magia de Disney", "description": "Princesas, clásicos y villanos de ensueño.", "link_text": "Explorar Disney", "card_bg": "bg-white", "icon_bg": "bg-cozy-mintLight" } }
      ]
    }
  ]
}
{% endschema %}
