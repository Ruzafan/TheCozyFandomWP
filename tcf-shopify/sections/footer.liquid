{%- comment -%}
  Cozy Fandom Footer — newsletter signup, link columns, legal, socials.
{%- endcomment -%}

<footer class="cozy-footer bg-cozy-coffee text-white/90 pt-14 pb-8">
  <div class="max-w-[1400px] mx-auto px-4">

    <div class="cozy-footer-newsletter bg-white/5 border border-white/10 rounded-[28px] p-6 md:p-8 mb-12 flex flex-col md:flex-row items-center gap-6">
      <div class="flex-1 text-center md:text-left">
        <h3 class="font-serif text-xl font-bold text-white mb-1">{{ section.settings.newsletter_title | default: 'Únete al club Cozy' }}</h3>
        <p class="text-sm text-white/60 m-0">{{ section.settings.newsletter_subtitle | default: 'Novedades, ofertas y mensajes cozy directos a tu correo.' }}</p>
      </div>
      {%- form 'customer', id: 'cozy-newsletter-form', class: 'flex w-full md:w-auto gap-2' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sr-only" for="NewsletterEmail">Email</label>
        <input type="email" name="contact[email]" id="NewsletterEmail" required placeholder="tu@email.com"
               class="bg-white text-cozy-coffee text-sm rounded-full px-4 py-3 border-0 flex-1 md:w-64 focus:outline-none focus:ring-2 focus:ring-cozy-mint">
        <button type="submit" class="bg-cozy-mint hover:bg-cozy-mintDark text-cozy-coffee font-bold text-sm px-5 py-3 rounded-full border-0 cursor-pointer whitespace-nowrap">
          Suscribirme
        </button>
        {%- if form.posted_successfully? -%}
          <p class="text-cozy-mint text-xs mt-2 basis-full">¡Gracias por unirte! 🍵</p>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
      <div>
        <span class="font-serif font-bold text-white block mb-3">{{ shop.name }}</span>
        <p class="text-xs text-white/50 leading-relaxed">{{ section.settings.about_text | default: 'Tu rincón cozy para merchandising oficial de tus fandoms favoritos.' }}</p>
      </div>

      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-white/70 block mb-3">Tienda</span>
        <ul class="list-none p-0 m-0 space-y-2">
          <li><a href="{{ routes.all_products_collection_url }}" class="text-xs text-white/60 hover:text-white no-underline">Todos los productos</a></li>
          <li><a href="{{ routes.search_url }}" class="text-xs text-white/60 hover:text-white no-underline">Buscar</a></li>
          <li><a href="{{ routes.account_url }}" class="text-xs text-white/60 hover:text-white no-underline">Mi cuenta</a></li>
        </ul>
      </div>

      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-white/70 block mb-3">Legal</span>
        <ul class="list-none p-0 m-0 space-y-2">
          <li><a href="{{ pages['politica-de-privacidad'].url | default: '#' }}" class="text-xs text-white/60 hover:text-white no-underline">Política de privacidad</a></li>
          <li><a href="{{ pages['terminos-y-condiciones'].url | default: '#' }}" class="text-xs text-white/60 hover:text-white no-underline">Términos y condiciones</a></li>
          <li><a href="{{ pages['envios-y-devoluciones'].url | default: '#' }}" class="text-xs text-white/60 hover:text-white no-underline">Envíos y devoluciones</a></li>
          <li><button type="button" data-action="open-cookie-settings" class="text-xs text-white/60 hover:text-white bg-transparent border-0 p-0 cursor-pointer underline">Configurar cookies</button></li>
        </ul>
      </div>

      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-white/70 block mb-3">Síguenos</span>
        <div class="flex items-center gap-3">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="text-white/60 hover:text-white" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="text-white/60 hover:text-white" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-[11px] text-white/40 m-0">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "newsletter_title", "label": "Título newsletter", "default": "Únete al club Cozy" },
    { "type": "text", "id": "newsletter_subtitle", "label": "Subtítulo newsletter" },
    { "type": "textarea", "id": "about_text", "label": "Texto sobre la tienda" },
    { "type": "url", "id": "instagram_url", "label": "URL Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "URL TikTok" }
  ]
}
{% endschema %}
