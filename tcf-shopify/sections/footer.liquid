<footer class="cozy-footer bg-cozy-coffee text-white/70 pt-12 md:pt-16 pb-8 px-6 md:px-12 relative overflow-hidden mt-12">
    <div class="absolute top-0 left-1/4 w-72 h-72 bg-cozy-mint/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto relative z-10">

        <!-- Newsletter signup -->
        <div class="max-w-lg mx-auto text-center mb-10 pb-10 border-b border-white/10">
            <span class="font-serif text-lg font-bold text-white block mb-2">
                {{ section.settings.newsletter_title | default: '✨ Únete al Cozy Club' }}
            </span>
            <p class="text-xs text-white/60 mb-4 m-0">
                {{ section.settings.newsletter_text | default: 'Recibe un 5% de descuento en tu primer pedido. Cero spam.' }}
            </p>
            {% form 'customer', id: 'cozy-newsletter-form', class: 'flex flex-col sm:flex-row gap-2 w-full' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                    <div class="w-full p-3 bg-cozy-mintLight border border-cozy-mint rounded-2xl text-cozy-coffee text-xs font-bold">
                        🎉 ¡Bienvenido al Cozy Club! Revisa tu email para tu código de descuento.
                    </div>
                {%- else -%}
                    <input type="email"
                           name="contact[email]"
                           id="NewsletterEmail-{{ section.id }}"
                           value="{{ form.email }}"
                           placeholder="Tu correo electrónico..."
                           required
                           class="flex-1 px-4 py-2.5 rounded-2xl bg-white/10 border-2 border-white/20 focus:border-cozy-mint text-xs text-white outline-none placeholder-white/40">
                    <button type="submit"
                            class="bg-cozy-mint hover:bg-cozy-mintDark text-cozy-coffee font-bold px-5 py-2.5 rounded-2xl text-xs transition-all border-0 cursor-pointer shrink-0">
                        Suscribirme
                    </button>
                    {%- if form.errors -%}
                        <p class="text-red-400 text-xs mt-1 w-full text-left">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
                    {%- endif -%}
                {%- endif -%}
            {% endform %}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10 pb-10 border-b border-white/10">

            <!-- Brand + Social -->
            <div class="space-y-4">
                <span class="font-serif text-xl font-bold text-white block">{{ section.settings.brand_title | default: '🌿 The Cozy Fandom' }}</span>
                <p class="text-xs text-white/60 leading-relaxed max-w-xs m-0">
                    {{ section.settings.brand_desc | default: 'Coleccionables bonitos, papelería aesthetic y detalles con alma para un hogar relajado.' }}
                </p>
                <div class="flex items-center gap-3 pt-2">
                    {%- if settings.social_instagram_url != blank -%}
                    <a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener noreferrer"
                       aria-label="Instagram"
                       class="w-9 h-9 rounded-full bg-white/10 hover:bg-cozy-mint flex items-center justify-center text-white hover:text-cozy-coffee transition-colors no-underline">
                        {% render 'cozy-icons', name: 'instagram', size: 16 %}
                    </a>
                    {%- endif -%}
                    {%- if settings.social_tiktok_url != blank -%}
                    <a href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener noreferrer"
                       aria-label="TikTok"
                       class="w-9 h-9 rounded-full bg-white/10 hover:bg-cozy-mint flex items-center justify-center text-white hover:text-cozy-coffee transition-colors no-underline">
                        {% render 'cozy-icons', name: 'tiktok', size: 16 %}
                    </a>
                    {%- endif -%}
                </div>
            </div>

            <!-- Tienda -->
            <div>
                <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4 m-0">Tienda</h4>
                <ul class="space-y-2.5 text-xs list-none p-0 m-0">
                    <li><a href="/" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Inicio</a></li>
                    <li><a href="/collections/all" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Boutique Completa</a></li>
                    <li><a href="/collections/snoopy" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Snoopy 🐾</a></li>
                    <li><a href="/collections/harry-potter" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Harry Potter ⚡</a></li>
                    <li><a href="/collections/disney" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Disney ✨</a></li>
                </ul>
            </div>

            <!-- Legal / Información -->
            <div>
                <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4 m-0">Información</h4>
                <ul class="space-y-2.5 text-xs list-none p-0 m-0">
                    <li><a href="/pages/envios-y-devoluciones" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Envíos y devoluciones</a></li>
                    <li><a href="/pages/politica-de-privacidad" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Política de privacidad</a></li>
                    <li><button type="button" data-action="open-cookie-settings" class="text-white/70 hover:text-cozy-mint transition-colors bg-transparent border-0 p-0 m-0 cursor-pointer text-left text-xs font-inherit">Configuración de cookies</button></li>
                    <li><a href="/pages/terminos-y-condiciones" class="text-white/70 hover:text-cozy-mint transition-colors no-underline">Términos y condiciones</a></li>
                </ul>
            </div>

            <!-- Contacto -->
            <div>
                <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4 m-0">Contacto</h4>
                <p class="text-xs text-white/60 leading-relaxed mb-3 m-0">¿Tienes dudas? Te atendemos con un té calentito 🍵</p>
                <a href="mailto:{{ settings.contact_email | default: shop.email }}" class="text-xs font-bold text-cozy-mint hover:underline break-all block mb-3">
                    {{ settings.contact_email | default: shop.email }}
                </a>
                {%- if settings.whatsapp_number != blank -%}
                    <a href="https://wa.me/{{ settings.whatsapp_number }}?text=Hola,%20tengo%20una%20duda%20sobre%20la%20tienda" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-bold px-4 py-2 rounded-xl transition-colors no-underline shadow-xs">
                        <span>💬 WhatsApp</span>
                    </a>
                {%- endif -%}
            </div>

        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-white/40">
            <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</span>
            <span>Hecho con 🌿 para fans cozy</span>
        </div>

    </div>
</footer>

{% schema %}
{
  "name": "Pie de Página",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Nombre de marca",
      "default": "🌿 The Cozy Fandom"
    },
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Descripción corta",
      "default": "Coleccionables bonitos, papelería aesthetic y detalles con alma para un hogar relajado."
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título newsletter",
      "default": "✨ Únete al Cozy Club"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Texto newsletter",
      "default": "Recibe un 5% de descuento en tu primer pedido. Cero spam."
    }
  ]
}
{% endschema %}
