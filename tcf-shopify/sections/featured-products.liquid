{%- comment -%}
  Cozy Fandom Featured Products — "Top Ventas" grid over a mint/cream/sand gradient.
{%- endcomment -%}

<section class="relative overflow-hidden bg-gradient-to-br from-cozy-mintLight/80 via-cozy-cream to-cozy-sand/50 py-16 px-6 md:px-12 rounded-[32px] border border-cozy-mint/30 shadow-sm max-w-7xl mx-auto mt-5">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="inline-flex items-center gap-1.5 bg-white/60 text-cozy-coffee text-[11px] font-bold px-3 py-1 rounded-full mb-3">
          🔥 {{ section.settings.eyebrow | default: 'Los Más Buscados' }}
        </span>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-cozy-coffee">{{ section.settings.title | default: 'Top Ventas' }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="text-sm text-cozy-coffee/70 mt-2">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
      <div class="mt-4 md:mt-0">
        <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}"
           class="bg-white hover:bg-cozy-mintLight text-cozy-coffee px-5 py-2 rounded-full text-xs font-medium border border-cozy-sand transition-colors no-underline">
          Ver todos los productos →
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {%- assign top_products = section.settings.collection.products -%}
      {%- if top_products.size > 0 -%}
        {%- for product in top_products limit: section.settings.product_limit -%}
          {% render 'product-card', product: product, rank: forloop.index %}
        {%- endfor -%}
      {%- else -%}
        <div class="col-span-full text-center py-16">
          <p class="text-cozy-coffee/60 text-sm">Selecciona una colección de "Top Ventas" en la configuración de esta sección.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Top Ventas",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "product_limit", "label": "Nº de productos", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "eyebrow", "label": "Texto de la insignia", "default": "Los Más Buscados" },
    { "type": "text", "id": "title", "label": "Título", "default": "Top Ventas" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" }
  ],
  "presets": [
    { "name": "Top Ventas" }
  ]
}
{% endschema %}
