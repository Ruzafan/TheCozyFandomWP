<header id="masthead" class="site-header sticky top-0 z-[999] bg-[#f6eee1] transition-shadow duration-300 border-b border-cozy-sand/70">

    <!-- ── Row 1: Logo · Search · Icons ───────────────────────── -->
    <div class="ast-primary-header-bar">
        <div class="cozy-hdr-inner max-w-7xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between gap-4">

            <!-- Logo -->
            <a href="/" class="cozy-hdr-logo flex items-center gap-3 no-underline shrink-0" aria-label="{{ shop.name }}">
                {%- if section.settings.logo != blank -%}
                    <img src="{{ section.settings.logo | image_url: width: 160 }}" alt="{{ shop.name }}" class="h-10 w-auto object-contain">
                {%- elsif section.settings.logo_image_asset != blank -%}
                    <img src="{{ section.settings.logo_image_asset | asset_url }}" alt="{{ shop.name }}" class="h-10 w-auto object-contain">
                {%- endif -%}
                <div class="cozy-hdr-logo__text-wrap flex flex-col">
                    <span class="cozy-hdr-logo__name font-serif text-xl sm:text-2xl font-bold text-cozy-coffee tracking-tight">{{ section.settings.logo_text | default: shop.name }}</span>
                    {%- if section.settings.tagline != blank -%}
                        <span class="cozy-hdr-logo__tagline text-[10px] uppercase tracking-wider font-semibold text-cozy-coffee/50">{{ section.settings.tagline }}</span>
                    {%- endif -%}
                </div>
            </a>

            <!-- Live Search -->
            <div class="cozy-hdr-search-wrap relative flex-1 max-w-md hidden sm:block">
                <form action="/search" method="get" role="search" class="cozy-hdr-search flex items-center bg-white rounded-2xl border-2 border-cozy-sand overflow-hidden focus-within:border-cozy-mint transition-colors">
                    <input type="search" name="q" placeholder="Buscar tesoros, tazas, papelería..." class="cozy-hdr-search__input flex-1 px-4 py-2 text-xs text-cozy-coffee bg-transparent border-0 outline-none placeholder-cozy-coffee/40" autocomplete="off">
                    <input type="hidden" name="type" value="product">
                    <button type="submit" class="cozy-hdr-search__btn px-4 py-2.5 bg-cozy-mint hover:bg-cozy-mintDark text-white border-0 cursor-pointer flex items-center justify-center transition-colors" aria-label="Buscar">
                        {% render 'cozy-icons', name: 'search', size: 16 %}
                    </button>
                </form>
                <div id="cozy-search-suggestions" class="cozy-search-suggestions hidden absolute top-full left-0 right-0 mt-2 bg-white/95 backdrop-blur-md border-2 border-cozy-sand rounded-2xl shadow-xl z-50 max-h-80 overflow-y-auto"></div>
            </div>

            <!-- Header Action Icons -->
            <div class="cozy-hdr-actions flex items-center gap-2">

                <div class="cozy-hdr-actions-icons flex items-center gap-2">
                    <!-- Customer Account -->
                    <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="cozy-hdr-icon w-10 h-10 rounded-full flex items-center justify-center text-cozy-coffee hover:bg-cozy-sand transition-colors no-underline hidden md:flex" aria-label="Mi cuenta">
                        {% render 'cozy-icons', name: 'account', size: 19 %}
                    </a>

                    <!-- Favorites -->
                    <button type="button" data-action="open-favorites" class="cozy-hdr-icon relative w-10 h-10 rounded-full flex items-center justify-center text-cozy-coffee hover:bg-cozy-sand transition-colors border-0 bg-transparent cursor-pointer" aria-label="Mis favoritos">
                        {% render 'cozy-icons', name: 'heart', size: 19 %}
                        <span id="fav-badge" class="hidden absolute -top-0.5 -right-0.5 bg-red-400 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center font-bold shadow-xs">0</span>
                    </button>

                    <!-- Cart -->
                    <button type="button" data-action="open-cart" class="cozy-hdr-icon cozy-hdr-cart relative w-10 h-10 rounded-full flex items-center justify-center text-cozy-coffee hover:bg-cozy-sand transition-colors border-0 bg-transparent cursor-pointer" aria-label="Carrito">
                        {% render 'cozy-icons', name: 'cart', size: 19 %}
                        <span id="cart-badge" class="{% if cart.item_count == 0 %}hidden{% endif %} absolute -top-0.5 -right-0.5 bg-cozy-mint text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center font-bold shadow-xs">
                            {{ cart.item_count }}
                        </span>
                    </button>

                    <!-- Ultra Cozy Toggle -->
                    {%- if section.settings.enable_ultra_cozy -%}
                    <div class="cozy-hdr-switch-wrap flex items-center gap-2 border-l border-cozy-sand/80 pl-3 ml-1 hidden lg:flex">
                        <span class="text-[11px] font-bold text-cozy-coffee uppercase tracking-wider">Modo Cozy</span>
                        <label class="relative inline-flex items-center cursor-pointer select-none" title="Activar Modo Cozy (Lluvia & Sonido)">
                            <input type="checkbox" id="cozy-ultra-checkbox" data-action="toggle-ultra-cozy" class="sr-only peer">
                            <div class="w-10 h-5 bg-cozy-sand peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-cozy-sand after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-cozy-mint shadow-inner"></div>
                        </label>
                    </div>
                    {%- endif -%}
                </div>

                <!-- Mobile Hamburger -->
                <button type="button" data-action="toggle-mobile-menu" class="cozy-hdr-icon cozy-hdr-hamburger md:hidden w-10 h-10 rounded-full flex items-center justify-center text-cozy-coffee hover:bg-cozy-sand transition-colors border-0 bg-transparent cursor-pointer" aria-label="Abrir Menú">
                    {% render 'cozy-icons', name: 'menu', size: 20 %}
                </button>
            </div>

        </div>
    </div>

</header>

<!-- ── Row 2: Category navigation bar (Desktop) & Mobile drawer ── -->
<div class="cozy-hdr-nav-row bg-[#f6eee1] border-b border-cozy-sand/60 hidden md:block" id="cozy-nav-desktop">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
        <nav class="cozy-hdr-nav flex items-center gap-1 py-1.5 overflow-x-auto" aria-label="Navegación principal">
            <a href="/" class="cozy-nav-link text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors no-underline">
                Inicio
            </a>
            <a href="/collections/all" class="cozy-nav-link text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors no-underline">
                Boutique
            </a>

            {%- if section.settings.menu != blank -%}
                {%- for link in linklists[section.settings.menu].links -%}
                    {%- if link.links != blank -%}
                        <div class="cozy-nav-item relative group">
                            <button type="button" class="cozy-nav-link flex items-center gap-1 text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors bg-transparent border-0 cursor-pointer">
                                {{ link.title }}
                                {% render 'cozy-icons', name: 'chevron-down', size: 10 %}
                            </button>
                            <div class="cozy-nav-dropdown hidden group-hover:block absolute top-full left-0 bg-white border border-cozy-sand rounded-2xl shadow-xl p-2 min-w-[180px] z-50 space-y-1">
                                {%- for child_link in link.links -%}
                                    <a href="{{ child_link.url }}" class="block px-3 py-1.5 text-xs text-cozy-coffee/80 hover:text-cozy-coffee hover:bg-cozy-mintLight rounded-xl transition-colors no-underline">
                                        {{ child_link.title }}
                                    </a>
                                {%- endfor -%}
                            </div>
                        </div>
                    {%- else -%}
                        <a href="{{ link.url }}" class="cozy-nav-link text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors no-underline">
                            {{ link.title }}
                        </a>
                    {%- endif -%}
                {%- endfor -%}
            {%- else -%}
                <!-- Default Fandom Categories if menu not assigned -->
                <a href="/collections/snoopy" class="cozy-nav-link text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors no-underline">Snoopy 🐾</a>
                <a href="/collections/harry-potter" class="cozy-nav-link text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors no-underline">Harry Potter ⚡</a>
                <a href="/collections/disney" class="cozy-nav-link text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors no-underline">Disney ✨</a>
                <a href="/collections/pokemon" class="cozy-nav-link text-xs font-bold text-cozy-coffee/80 hover:text-cozy-coffee px-3 py-1.5 rounded-xl hover:bg-cozy-mint/15 transition-colors no-underline">Pokémon ⚡</a>
            {%- endif -%}
        </nav>
    </div>
</div>

<!-- Mobile Nav Drawer -->
<div id="cozy-nav-sidebar" class="fixed inset-y-0 left-0 w-72 bg-[#f6eee1] z-[1200] transform -translate-x-full transition-transform duration-300 shadow-2xl flex flex-col md:hidden">
    <div class="p-4 border-b border-cozy-sand/80 flex items-center justify-between">
        <span class="font-serif font-bold text-lg text-cozy-coffee">Menú</span>
        <button type="button" data-action="close-mobile-menu" class="w-8 h-8 rounded-full bg-cozy-cream hover:bg-cozy-sand flex items-center justify-center text-cozy-coffee border-0 cursor-pointer" aria-label="Cerrar">
            {% render 'cozy-icons', name: 'close', size: 14 %}
        </button>
    </div>

    <!-- Quick mobile actions -->
    <div class="p-3 border-b border-cozy-sand/80 grid grid-cols-3 gap-2">
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="flex flex-col items-center p-2 rounded-xl bg-white text-cozy-coffee text-center no-underline text-[10px] font-bold">
            {% render 'cozy-icons', name: 'account', size: 18 %}
            <span class="mt-1">Cuenta</span>
        </a>
        <button type="button" data-action="close-mobile-menu-open-favorites" class="flex flex-col items-center p-2 rounded-xl bg-white text-cozy-coffee text-center border-0 cursor-pointer text-[10px] font-bold">
            {% render 'cozy-icons', name: 'heart', size: 18 %}
            <span class="mt-1">Favoritos</span>
        </button>
        <button type="button" data-action="close-mobile-menu-open-cart" class="flex flex-col items-center p-2 rounded-xl bg-white text-cozy-coffee text-center border-0 cursor-pointer text-[10px] font-bold">
            {% render 'cozy-icons', name: 'cart', size: 18 %}
            <span class="mt-1">Carrito</span>
        </button>
    </div>

    <div class="p-4 overflow-y-auto flex-grow space-y-1">
        <a href="/" class="block px-3 py-2 text-sm font-bold text-cozy-coffee hover:bg-white rounded-xl no-underline">Inicio</a>
        <a href="/collections/all" class="block px-3 py-2 text-sm font-bold text-cozy-coffee hover:bg-white rounded-xl no-underline">Boutique Completa</a>
        <a href="/collections/snoopy" class="block px-3 py-2 text-sm font-bold text-cozy-coffee hover:bg-white rounded-xl no-underline">Snoopy 🐾</a>
        <a href="/collections/harry-potter" class="block px-3 py-2 text-sm font-bold text-cozy-coffee hover:bg-white rounded-xl no-underline">Harry Potter ⚡</a>
        <a href="/collections/disney" class="block px-3 py-2 text-sm font-bold text-cozy-coffee hover:bg-white rounded-xl no-underline">Disney ✨</a>
        <a href="/collections/pokemon" class="block px-3 py-2 text-sm font-bold text-cozy-coffee hover:bg-white rounded-xl no-underline">Pokémon ⚡</a>
    </div>

    <!-- Mobile Ultra Cozy Toggle -->
    <div class="p-4 border-t border-cozy-sand/80 bg-white/50 flex items-center justify-between">
        <span class="text-xs font-bold text-cozy-coffee">Modo Ultra-Cozy</span>
        <label class="relative inline-flex items-center cursor-pointer select-none">
            <input type="checkbox" id="cozy-ultra-checkbox-mobile" data-action="toggle-ultra-cozy" class="sr-only peer">
            <div class="w-9 h-5 bg-cozy-sand peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-cozy-sand after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-cozy-mint shadow-inner"></div>
        </label>
    </div>
</div>
<div id="mobile-menu-overlay" data-action="close-mobile-menu" class="hidden fixed inset-0 bg-cozy-coffee/40 z-[1199] backdrop-blur-sm"></div>

{% schema %}
{
  "name": "Cabecera",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de la tienda"
    },
    {
      "type": "text",
      "id": "logo_image_asset",
      "label": "O nombre del archivo en assets (ej: logo.webp)",
      "default": "logo.webp"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texto del logo",
      "default": "The Cozy Fandom"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Subtítulo del logo",
      "default": "Boutique & Coleccionables"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú principal"
    },
    {
      "type": "checkbox",
      "id": "enable_ultra_cozy",
      "label": "Habilitar interruptor Modo Cozy",
      "default": true
    }
  ]
}
{% endschema %}
