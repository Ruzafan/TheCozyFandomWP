<section id="home" class="relative overflow-hidden">

    <!-- Banner image with overlay copy -->
    <div class="relative w-full h-[60vh] md:h-[80vh] min-h-[480px]">

        {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1800 }}"
                 alt="{{ section.settings.title | escape }}"
                 class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none">
        {%- elsif section.settings.image_asset != blank -%}
            <img src="{{ section.settings.image_asset | asset_url }}"
                 alt="{{ section.settings.title | escape }}"
                 class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none">
        {%- endif -%}

        <!-- Copy: glass card -->
        <div class="relative z-10 h-full flex items-center">
            <div class="w-full max-w-7xl mx-auto px-6 md:px-16">
                <div class="rounded-[28px] p-8 md:p-10 max-w-[480px] shadow-lg border border-white/50"
                     style="background:rgba(255,255,255,0.78); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);">

                    <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-semibold leading-tight text-cozy-coffee m-0 p-0">
                        {{ section.settings.title }}
                    </h1>
                    <p class="text-xs sm:text-sm md:text-base text-cozy-coffee/80 leading-relaxed mt-4 mb-6">
                        {{ section.settings.text }}
                    </p>

                    <a href="{{ section.settings.button_link | default: '/collections/all' }}"
                       class="inline-flex items-center gap-2 bg-cozy-mint hover:bg-cozy-mintDark text-cozy-coffee font-semibold px-7 py-3.5 rounded-2xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 no-underline">
                        {{ section.settings.button_label | default: 'Ver la Colección' }}
                        {% render 'cozy-icons', name: 'arrow-right', size: 14 %}
                    </a>
                </div>
            </div>
        </div>

    </div>
</section>

{% schema %}
{
  "name": "Banner Principal (Hero)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "O nombre del archivo en assets",
      "default": "banner.webp"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Título",
      "default": "Tu rincón friki <span class='italic text-cozy-mint font-normal block md:inline'>más acogedor</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto descriptivo",
      "default": "Coleccionables bonitos, papelería aesthetic y detalles con alma para un hogar relajado. Merchandising oficial seleccionado con un toque cálido y sofisticado."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver la Colección"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Banner Principal (Hero)"
    }
  ]
}
{% endschema %}
