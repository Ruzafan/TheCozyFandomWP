{%- comment -%}
  Floating Virtual Drink Companion Snippet
{%- endcomment -%}
<div id="cozy-drink-widget" class="hidden fixed bottom-6 right-24 z-[998] items-center gap-2 bg-white/90 backdrop-blur-md border border-cozy-sand rounded-full pl-3 pr-2 py-1.5 shadow-md transition-all">
    <div class="relative flex items-center justify-center text-lg select-none">
        <span id="cozy-drink-steam" class="absolute -top-3 text-[10px] opacity-70 animate-bounce pointer-events-none">♨️</span>
        <span id="cozy-drink-emoji" class="cursor-pointer" data-action="toggle-drink-menu">🍵</span>
    </div>
    <span id="cozy-drink-name" class="text-xs font-bold text-cozy-coffee max-w-[100px] truncate hidden sm:inline">Matcha Latte</span>
    <button type="button" data-action="toggle-drink-menu" class="w-6 h-6 rounded-full bg-cozy-cream hover:bg-cozy-sand flex items-center justify-center text-cozy-coffee border-0 cursor-pointer text-xs transition-colors" title="Cambiar bebida">
        ⚙️
    </button>
</div>

<!-- DRINK SELECTION MODAL -->
<div id="cozy-drink-modal" class="hidden fixed inset-0 bg-cozy-coffee/40 z-[2000] flex items-center justify-center p-4 backdrop-blur-sm" data-close-on-self="close-drink-modal">
    <div class="bg-white rounded-[32px] p-6 max-w-xs w-full shadow-2xl relative text-center border border-cozy-sand">
        <button type="button" data-action="close-drink-modal" class="absolute top-4 right-4 w-7 h-7 rounded-full bg-cozy-cream hover:bg-cozy-sand flex items-center justify-center text-cozy-coffee border-0 cursor-pointer text-xs" aria-label="Cerrar">
            ✕
        </button>
        <div class="w-12 h-12 rounded-2xl bg-cozy-mintLight flex items-center justify-center mx-auto mb-3 text-2xl">
            ☕
        </div>
        <h3 class="font-serif text-lg font-bold text-cozy-coffee mb-1">Tu Bebida Virtual</h3>
        <p class="text-xs text-cozy-coffee/60 mb-4">Elige qué taza quieres que te acompañe mientras descubres la tienda.</p>

        <div class="space-y-2">
            <button type="button" data-action="select-drink" data-drink="🍵|Matcha Latte" class="w-full flex items-center justify-between p-2.5 rounded-xl border border-cozy-sand/80 hover:bg-cozy-mintLight transition-colors text-xs font-bold text-cozy-coffee bg-white cursor-pointer">
                <span>🍵 Matcha Latte Cremoso</span>
                <span class="text-cozy-mint">Elegir</span>
            </button>
            <button type="button" data-action="select-drink" data-drink="☕|Café con Canela" class="w-full flex items-center justify-between p-2.5 rounded-xl border border-cozy-sand/80 hover:bg-cozy-mintLight transition-colors text-xs font-bold text-cozy-coffee bg-white cursor-pointer">
                <span>☕ Café con Canela</span>
                <span class="text-cozy-mint">Elegir</span>
            </button>
            <button type="button" data-action="select-drink" data-drink="🫖|Té Chai Especiado" class="w-full flex items-center justify-between p-2.5 rounded-xl border border-cozy-sand/80 hover:bg-cozy-mintLight transition-colors text-xs font-bold text-cozy-coffee bg-white cursor-pointer">
                <span>🫖 Té Chai Especiado</span>
                <span class="text-cozy-mint">Elegir</span>
            </button>
            <button type="button" data-action="select-drink" data-drink="🍫|Chocolate con Nubes" class="w-full flex items-center justify-between p-2.5 rounded-xl border border-cozy-sand/80 hover:bg-cozy-mintLight transition-colors text-xs font-bold text-cozy-coffee bg-white cursor-pointer">
                <span>🍫 Chocolate con Nubes</span>
                <span class="text-cozy-mint">Elegir</span>
            </button>
        </div>
    </div>
</div>
